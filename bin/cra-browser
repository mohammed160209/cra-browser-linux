#!/usr/bin/env python3
"""Launcher script for Cra Browser Linux."""

import os
import sys

# Ensure local cra_browser package is importable when running from git checkout
repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if os.path.isdir(os.path.join(repo_root, "cra_browser")) and repo_root not in sys.path:
    sys.path.insert(0, repo_root)

from cra_browser.app import main

if __name__ == "__main__":
    sys.exit(main())
