[Desktop Entry]
Name=Cra Browser
Comment=A native Linux browser with an Arc-style sidebar, spaces, and split view
GenericName=Web Browser
Exec=cra-browser %U
Icon=app.crabrowser.Cra
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=app.crabrowser.Cra
